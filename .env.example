# Copy to .env and fill in (./setup.sh does this for you). `python server.py`
# auto-loads .env from this folder; real environment variables (e.g. from
# systemd or docker) still take precedence.

# ===========================================================================
# Tier 1 -- the laptop. These two are all you need.
# ===========================================================================

# Signs the login cookies. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# There is no default on purpose: a generated fallback would silently log
# everybody out on every restart. Change it and everyone signs in again.
SECRET_KEY=

# The familiar's brain. Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The voice. Piper runs on this machine, free, no network; setup.sh downloads
# one voice into voices/. Unset = each device's built-in browser voice.
TTS_PROVIDER=piper
PIPER_VOICE=en_GB-alan-medium

# ===========================================================================
# Tier 3 -- an always-on server behind Caddy (HTTPS)
# ===========================================================================

# Bind to localhost only, so the only way in is through Caddy's HTTPS.
# (Leave unset on a laptop: 0.0.0.0 lets phones on the same wifi reach it.)
# HOST=127.0.0.1
# PORT=8321

# Who may create an account. Unset, on an install that already has users,
# means NOBODY new -- the safe state is the one you get by forgetting. The
# very first account on a fresh install is always allowed.
#
#   SIGNUP_CODE=dragons-2026   a code is required (case and space forgiven)
#   SIGNUP_CODE=open           anyone may sign up -- strangers' tables would
#                              spend whatever API key this box holds
#   (unset)                    closed, once the first account exists
#
# Players never need this: they join through the DM's invite link.
# SIGNUP_CODE=

# Where tables keep their data, and where the accounts database lives.
# Defaults to ./data. Moving a table between machines is copying this folder.
# DATA_DIR=/var/lib/familiar

# Nightly backups (tools/backup.py, deploy/familiar-backup.timer). Anything
# S3-compatible (S3, Backblaze B2, Cloudflare R2, MinIO) via `pip install
# boto3`, or a path on another disk or machine. A path on the same disk as
# DATA_DIR survives a mistake, not a dead disk -- the tool warns you.
# BACKUP_DEST=s3://your-bucket/familiar
# BACKUP_DEST=/mnt/backups/familiar
# BACKUP_KEEP=14
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# BACKUP_S3_ENDPOINT=          # B2: https://s3.<region>.backblazeb2.com

# ===========================================================================
# Optional -- other brains and voices
# ===========================================================================

# LLM_PROVIDER is a comma-separated chain, tried in order -- e.g. "local,gemini"
# asks the LLM on your home network first and falls back to Gemini when that
# machine is off.
# LLM_PROVIDER=gemini            # gemini | claude | local
# GEMINI_MODEL=gemini-2.5-flash

# Gemini's "thinking" phase adds ~2.5s before the first word. 0 (the default)
# turns it off for snappy table answers; -1 lets Gemini decide per question.
# GEMINI_THINKING_BUDGET=0

# Claude (pip install anthropic). Paid; the den shows what each month cost.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# A local LLM: anything with an OpenAI-compatible API.
# Ollama: http://<pc-ip>:11434 (set OLLAMA_HOST=0.0.0.0 on that PC);
# LM Studio: http://<pc-ip>:1234 (tick "Serve on Local Network").
# LOCAL_LLM_URL=http://192.168.1.50:11434
# LOCAL_LLM_MODEL=llama3.1:8b

# Ambient fold-ins (summarising recorded table talk) allowed per table per
# hour -- a brake on a recorder left running in somebody's bag.
# FOLD_INS_PER_HOUR=12

# TTS_PROVIDER is a chain too, tried left to right (e.g. "pocket,piper"). If
# every provider fails the browser falls back to its own voice.
#
# Piper: a catalogue name resolves to voices/<name>.onnx. Fetch more with
#   .venv/bin/python -m piper.download_voices --data-dir voices <name>
#
# pocket-tts: Kyutai's CPU neural TTS (pip install -r requirements-pocket.txt,
# which pulls in ~700 MB of PyTorch). POCKET_VOICE is a preset name (alba,
# anna, giovanni, ...) or a path to a .wav clip to clone.
# POCKET_VOICE=alba
#
# Gemini TTS: free tier, reuses GEMINI_API_KEY.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Charon
#
# ElevenLabs: designed character voices (free tier ~10 min/month).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
